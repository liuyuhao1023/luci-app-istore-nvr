{
  "luci-app-istore-nvr": {
    "description": "Grant access to NVR Camera Manager configuration and service",
    "read": {
      "uci": [ "istore-nvr" ],
      "file": {
        "/bin/pidof": [ "exec" ],
        "/bin/ps": [ "exec" ],
        "/bin/ash": [ "exec" ],
        "/etc/init.d/istore-nvr": [ "exec" ]
      }
    },
    "write": {
      "uci": [ "istore-nvr" ]
    }
  }
}
