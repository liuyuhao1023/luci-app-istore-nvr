#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/mnt/sata1-4/istore-nvr/istore-nvr
BIN_FALLBACK=/usr/bin/istore-nvr
CONF=istore-nvr

start_service() {
    config_load "$CONF"
    
    local enabled port data_dir
    config_get_bool enabled config enabled 1
    config_get port config port 8080
    config_get data_dir config data_dir '/mnt/sata1-4/istore-nvr/data'

    [ "$enabled" -eq 1 ] || return 0

    local bin="$PROG"
    [ -x "$bin" ] || bin="$BIN_FALLBACK"

    if [ ! -x "$bin" ]; then
        echo "Error: istore-nvr executable not found in $PROG or $BIN_FALLBACK"
        return 1
    fi

    mkdir -p "$data_dir"

    procd_open_instance
    procd_set_param command "$bin" -port "$port" -db "$data_dir/nvr.db"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

stop_service() {
    killall istore-nvr 2>/dev/null
    killall mediamtx 2>/dev/null
}

reload_service() {
    stop
    start
}
