{
  "luci-app-nvr-manager": {
    "description": "Grant access to NVR Camera Manager configuration and service",
    "read": {
      "uci": [ "nvr-manager" ],
      "file": {
        "/bin/pidof": [ "exec" ],
        "/bin/ps": [ "exec" ],
        "/bin/ash": [ "exec" ],
        "/etc/init.d/nvr-manager": [ "exec" ]
      }
    },
    "write": {
      "uci": [ "nvr-manager" ]
    }
  }
}
