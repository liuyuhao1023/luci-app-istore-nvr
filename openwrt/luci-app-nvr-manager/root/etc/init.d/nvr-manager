#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/nvr-manager
CONF=nvr-manager

start_service() {
    config_load "$CONF"

    local enabled port data_dir record_dir
    config_get_bool enabled config enabled 0
    config_get port config port 8080
    config_get data_dir config data_dir ''
    config_get record_dir config record_dir ''

    [ "$enabled" -eq 1 ] || return 0

    if [ -z "$data_dir" ]; then
        echo "nvr-manager: data_dir is not configured. Please specify an external storage directory." >&2
        return 1
    fi

    if [ ! -x "$PROG" ]; then
        for alt in "$data_dir/nvr-manager" "$data_dir/istore-nvr" /usr/local/bin/nvr-manager /mnt/*/nvr-manager/nvr-manager /mnt/*/istore-nvr/istore-nvr /mnt/*/istore-nvr/nvr-manager; do
            if [ -x "$alt" ]; then
                PROG="$alt"
                break
            fi
        done
    fi

    if [ ! -x "$PROG" ]; then
        echo "Error: $PROG not found or not executable" >&2
        return 1
    fi

    if [ ! -x /usr/bin/mediamtx ]; then
        for malt in "$data_dir/mediamtx" /usr/local/bin/mediamtx /mnt/*/istore-nvr/mediamtx /mnt/*/nvr-manager/mediamtx; do
            if [ -x "$malt" ]; then
                ln -sf "$malt" /usr/bin/mediamtx 2>/dev/null || true
                break
            fi
        done
    fi

    mkdir -p "$data_dir"
    [ -n "$record_dir" ] && mkdir -p "$record_dir"

    procd_open_instance
    procd_set_param command "$PROG" -port "$port" -db "$data_dir/nvr.db"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

service_stopped() {
    if [ -f /var/run/mediamtx.pid ]; then
        local mpid
        mpid=$(cat /var/run/mediamtx.pid 2>/dev/null)
        [ -n "$mpid" ] && kill "$mpid" 2>/dev/null || true
        rm -f /var/run/mediamtx.pid
    fi
}

reload_service() {
    restart
}
