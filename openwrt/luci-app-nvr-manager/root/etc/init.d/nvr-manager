#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/nvr-manager
CONF=nvr-manager

start_service() {
    config_load "$CONF"

    local enabled port data_dir record_dir
    config_get_bool enabled config enabled 0
    config_get port config port 8080
    config_get data_dir config data_dir ''
    config_get record_dir config record_dir ''

    [ "$enabled" -eq 1 ] || return 0

    if [ -z "$data_dir" ]; then
        # 优先在真实挂载的外置磁盘中寻找最大可用空间的目录 (排除 tmpfs/rom/overlay)
        local best_mount=""
        local max_avail=0
        for m in $(df -k 2>/dev/null | awk '$6 ~ /^\/(mnt|media|opt)/ && $1 ~ /^\/dev/ {print $6}'); do
            local avail
            avail=$(df -k "$m" 2>/dev/null | awk 'NR==2 {print $4}')
            if [ -n "$avail" ] && [ "$avail" -gt "$max_avail" ]; then
                max_avail="$avail"
                best_mount="$m"
            fi
        done

        if [ -n "$best_mount" ]; then
            data_dir="$best_mount/nvr-manager/data"
            [ -z "$record_dir" ] && record_dir="$best_mount/nvr-manager/recordings"
        fi
    fi

    if [ -z "$data_dir" ]; then
        for d in /mnt/sata* /mnt/nvme* /mnt/sd* /mnt/vio* /mnt/disk* /mnt/* /media/*; do
            if [ -d "$d" ] && [ "$d" != "/mnt/*" ] && [ "$d" != "/media/*" ] && [ "$d" != "/mnt" ]; then
                local avail
                avail=$(df -k "$d" 2>/dev/null | awk 'NR==2 {print $4}')
                if [ -n "$avail" ] && [ "$avail" -gt 102400 ]; then
                    data_dir="$d/nvr-manager/data"
                    [ -z "$record_dir" ] && record_dir="$d/nvr-manager/recordings"
                    break
                fi
            fi
        done
    fi

    if [ -z "$data_dir" ]; then
        data_dir="/root/nvr-manager/data"
        [ -z "$record_dir" ] && record_dir="/root/nvr-manager/recordings"
    fi

    if [ ! -x "$PROG" ]; then
        for alt in "$data_dir/nvr-manager" "$data_dir/istore-nvr" /usr/local/bin/nvr-manager /mnt/*/nvr-manager/nvr-manager /mnt/*/istore-nvr/istore-nvr /mnt/*/istore-nvr/nvr-manager; do
            if [ -x "$alt" ]; then
                PROG="$alt"
                break
            fi
        done
    fi

    if [ ! -x "$PROG" ]; then
        echo "nvr-manager: core binary missing, attempting auto-download..." >&2
        mkdir -p /usr/bin
        curl -skL -m 30 -o /usr/bin/nvr-manager "https://github.com/liuyuhao1023/luci-app-istore-nvr/raw/main/bin/nvr-manager" 2>/dev/null || \
        uclient-fetch -q -T 30 -O /usr/bin/nvr-manager "https://github.com/liuyuhao1023/luci-app-istore-nvr/raw/main/bin/nvr-manager" 2>/dev/null || \
        wget -q -T 30 -O /usr/bin/nvr-manager "https://github.com/liuyuhao1023/luci-app-istore-nvr/raw/main/bin/nvr-manager" 2>/dev/null || true
        chmod 755 /usr/bin/nvr-manager 2>/dev/null || true
        [ -x /usr/bin/nvr-manager ] && PROG=/usr/bin/nvr-manager
    fi

    if [ ! -x "$PROG" ]; then
        echo "Error: $PROG not found or not executable. Please deploy the nvr-manager core binary." >&2
        return 1
    fi

    if [ ! -x /usr/bin/mediamtx ]; then
        for malt in "$data_dir/mediamtx" /usr/local/bin/mediamtx /mnt/*/istore-nvr/mediamtx /mnt/*/nvr-manager/mediamtx; do
            if [ -x "$malt" ]; then
                ln -sf "$malt" /usr/bin/mediamtx 2>/dev/null || true
                break
            fi
        done
    fi

    mkdir -p "$data_dir"
    [ -n "$record_dir" ] && mkdir -p "$record_dir"

    procd_open_instance
    procd_set_param command "$PROG" -port "$port" -db "$data_dir/nvr.db"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

service_stopped() {
    if [ -f /var/run/mediamtx.pid ]; then
        local mpid
        mpid=$(cat /var/run/mediamtx.pid 2>/dev/null)
        [ -n "$mpid" ] && kill "$mpid" 2>/dev/null || true
        rm -f /var/run/mediamtx.pid
    fi
}

reload_service() {
    restart
}
