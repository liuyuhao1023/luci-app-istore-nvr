#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/mnt/sata1-4/istore-nvr/istore-nvr
DATA_DIR=/mnt/sata1-4/istore-nvr/data
DIST_DIR=/mnt/sata1-4/istore-nvr/dist

start_service() {
    # 确保本地数据盘目录存在
    mkdir -p "$DATA_DIR"
    
    if [ ! -x "$PROG" ]; then
        echo "Error: $PROG not found or not executable"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" -port 8080 -db "$DATA_DIR/nvr.db"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

stop_service() {
    killall istore-nvr 2>/dev/null
    killall mediamtx 2>/dev/null
}

reload_service() {
    stop
    start
}
